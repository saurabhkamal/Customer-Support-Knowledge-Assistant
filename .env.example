# ---- Backend ----
DATABASE_URL=postgresql://postgres:your_password@db.xxxxxxxx.supabase.co:5432/postgres

# Use neo4j+s:// everywhere. neo4j+ssc:// skips certificate verification and is
# not safe outside a throwaway local experiment.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your_neo4j_password

OPENAI_API_KEY=sk-your-actual-key-here

# ---- Frontend (server-side only) ----
# Read at runtime by the Next.js /api proxy route. Never prefix these with
# NEXT_PUBLIC_ — that would inline them into the browser bundle.
# Mint the value with: cd backend && python scripts/create_first_key.py "local dev"
BACKEND_API_KEY=your_backend_api_key_here

# Dashboard login (gates the UI itself, separate from BACKEND_API_KEY above).
# APP_PASSWORD_HASH is never a plaintext password — generate it with:
#   cd frontend && node scripts/generate-password-hash.mjs
# SESSION_SECRET signs the login cookie; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_USERNAME=admin
APP_PASSWORD_HASH=
SESSION_SECRET=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Preferred: run `gh auth login --web` instead and leave GITHUB_TOKEN empty.
GITHUB_TOKEN=
GITHUB_REPO=owner/vanilatickingsystem

# ── AWS ───────────────────────────────────────────────────────────────────────
# Preferred: SSO profile (`aws sso login --profile ticketing-dev`) — no secret here.
AWS_PROFILE=ticketing-dev
AWS_ACCOUNT_ID=
AWS_REGION=eu-west-1
# Last resort only; prefer AWS_PROFILE above.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Azure ─────────────────────────────────────────────────────────────────────
# Preferred: `az login` and set only AZURE_SUBSCRIPTION_ID + location + RG.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_LOCATION=westeurope
AZURE_RESOURCE_GROUP=rg-ticketing-dev

# ── GCP ───────────────────────────────────────────────────────────────────────
# Preferred: `gcloud auth application-default login` + GCP_PROJECT_ID only.
GCP_PROJECT_ID=vanilaticktingsystemautomatoin
GCP_REGION=europe-west1
# Path to a service-account key file kept OUTSIDE this repo. Never paste key contents here.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_IMPERSONATE_SA=