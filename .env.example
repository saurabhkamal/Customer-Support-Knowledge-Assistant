DATABASE_URL=postgresql://postgres:your_password@db.xxxxxxxx.supabase.co:5432/postgres

# Note: neo4j+ssc:// is used instead of neo4j+s:// to work around a local network/TLS routing issue.
# If deploying to a cloud server, neo4j+s:// may work correctly there instead.
NEO4J_URI=neo4j+ssc://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your_neo4j_password

OPENAI_API_KEY=sk-your-actual-key-here