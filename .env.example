# ---- Backend ----
DATABASE_URL=postgresql://postgres:your_password@db.xxxxxxxx.supabase.co:5432/postgres

# Use neo4j+s:// everywhere. neo4j+ssc:// skips certificate verification and is
# not safe outside a throwaway local experiment.
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=your-instance-id
NEO4J_PASSWORD=your_neo4j_password

OPENAI_API_KEY=sk-your-actual-key-here

# ---- Frontend (server-side only) ----
# Read at runtime by the Next.js /api proxy route. Never prefix these with
# NEXT_PUBLIC_ — that would inline them into the browser bundle.
# Mint the value with: cd backend && python scripts/create_first_key.py "local dev"
BACKEND_API_KEY=your_backend_api_key_here
